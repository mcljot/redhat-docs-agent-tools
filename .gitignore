.DS_Store
.env
.cache/
# Claude Code runtime state (ignored by default)
.claude/*
# ACP requires committed symlinks and workflow config at clone time
!.claude/skills/
!.claude/agents/
!.claude/reference/
!.claude/docs-acp.yaml
artifacts/
site/
.venv/
.vale/
__pycache__/
node_modules/
.pytest_cache/
*.pyc
.work/
*-workspace/
# Workflow workspace (step outputs, progress files, cloned repos)
.agent_workspace/

# Auto-generated docs (built by CI, not tracked in source)
docs/plugins.md
docs/plugins/
docs/install/
docs/superpowers/
.vibe2doc
.ruff_cache

# Local specs and design docs (not tracked in source)
specs/
